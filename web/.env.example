# PostHog product analytics (client-side). Copy to `web/.env` for local dev.
# Both are inlined into the bundle by Bun at build time (BUN_PUBLIC_* prefix).
# Leave unset to disable analytics entirely — the SPA no-ops (OSS / self-host).
#
# Project API key from eu.posthog.com → Project settings. NOT a personal key.
BUN_PUBLIC_POSTHOG_KEY=
# Optional. Defaults to https://eu.i.posthog.com when unset.
BUN_PUBLIC_POSTHOG_HOST=
