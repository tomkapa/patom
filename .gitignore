/target
.env
.DS_Store
.idea/
.vscode/
*.swp
.claude/settings.local.json
# sqlx offline-prepare cache. We use only runtime sqlx (bound params + FromRow),
# so there are no compile-time query macros and no committed cache; ignore any
# `cargo sqlx prepare` output a contributor generates locally.
.sqlx/

# web/ — Bun-based frontend. node_modules and build output stay out of git;
# bun.lockb is checked in for reproducible installs.
web/node_modules/
web/dist/
web/.bun/

# Playwright MCP screenshots / accessibility snapshots saved during
# visual verification of the Connections UI. Local-only; never committed.
.playwright-mcp/
/v*.png
